# API 주소. 미설정 시 http://localhost:8080
# 실기기(Expo Go)에서 로컬 API 를 부르려면 PC 의 LAN IP 를 넣는다: http://192.168.x.x:8080
# 명세 테스트 화면은 이 주소에 /api/v1을 붙인다. 이미 /api/v1로 끝나면 중복하지 않는다.
# 기존 개발자 도구도 사용할 때는 경로 없는 서버 origin을 넣는다.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_USE_MOCK=false
# Google 로그인 클라이언트 ID. 값은 bawi-cloud-core notes/2026-11-14-gcp-terraform-chorong.md
# 네이티브 모듈이라 Expo Go 에서는 동작하지 않는다. EAS 빌드에서 시험한다.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Mock 상태 시험: empty 또는 error. 기본값은 데이터 표시.
# EXPO_PUBLIC_MOCK_SCENARIO=empty

{
  "name": "bawibase-chorong-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth": "tsc -p tests/tsconfig.json && node --test tests/auth.test.cjs",
    "test:quiz": "tsc -p tests/tsconfig.quiz.json && node --test tests/quiz.test.cjs",
    "test:integration": "tsc -p tests/tsconfig.integration.json && node --test tests/integration.test.cjs",
    "test:housing": "tsc -p tests/tsconfig.housing.json && node --test tests/housing.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
